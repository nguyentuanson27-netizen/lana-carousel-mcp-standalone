NODE_ENV=production
PORT=8787
PUBLIC_BASE_URL=https://content.lanadesign.tech
DATABASE_PATH=./data/lana-carousel.sqlite
ASSET_DIRECTORY=./data/assets

# Browser/admin login + MCP OAuth
# Create a Google OAuth 2.0 Web application and register this redirect URI:
# https://content.lanadesign.tech/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Production requires at least one allowlist. Comma-separated values are supported.
OAUTH_ALLOWED_EMAILS=
OAUTH_ALLOWED_DOMAINS=
# Required when production OAuth uses an HTTPS PUBLIC_BASE_URL because Node listens plain HTTP
# behind a TLS-terminating reverse proxy. List only proxy IPs/subnets you control; Express will
# trust X-Forwarded-* only from these ranges. Example for a proxy connecting from loopback only:
# OAUTH_TRUSTED_PROXY_CIDRS=127.0.0.1/8,::1/128
OAUTH_TRUSTED_PROXY_CIDRS=
OAUTH_ACCESS_TOKEN_TTL_SECONDS=3600
OAUTH_REFRESH_TOKEN_TTL_SECONDS=2592000
OAUTH_AUTHORIZATION_CODE_TTL_SECONDS=300
OAUTH_LOGIN_STATE_TTL_SECONDS=600
OAUTH_CONSENT_TTL_SECONDS=300

# Optional legacy/break-glass REST API keys. These are NOT used by browser login or /mcp.
# Send only as X-API-Key. MCP requires OAuth Bearer tokens.
# openssl rand -hex 32
# API_KEY=<paste-the-generated-64-character-value>
# API_KEYS=<old-key>,<new-key>
API_RATE_LIMIT_PER_MINUTE=120
API_DAILY_MUTATION_QUOTA=500
API_DAILY_HEAVY_QUOTA=60
PROJECT_ACCESS_TOKEN_TTL_SECONDS=300
PROJECT_SESSION_TTL_SECONDS=3600
MCP_MAX_SESSIONS_PER_PRINCIPAL=200
MCP_SESSION_TTL_SECONDS=1800

MAX_IMAGE_BYTES=10485760
IMAGE_TIMEOUT_MS=15000
MAX_REMOTE_AUDIO_BYTES=26214400
REMOTE_AUDIO_TIMEOUT_MS=20000
PROJECT_AUDIO_STAGED_TTL_SECONDS=3600
PROJECT_AUDIO_MAX_FILES=20
PROJECT_AUDIO_MAX_BYTES=262144000
MAX_REMOTE_VIDEO_BYTES=524288000
VIDEO_SOURCE_TIMEOUT_MS=120000
MAX_REDIRECTS=3

# Social Publisher
# Keep SOCIAL_TOKEN_ENCRYPTION_KEY stable after accounts have been connected.
# Generate independent random values with: openssl rand -hex 32
SOCIAL_TOKEN_ENCRYPTION_KEY=
SOCIAL_OAUTH_STATE_SECRET=
SOCIAL_MEDIA_SIGNING_SECRET=
SOCIAL_MEDIA_URL_TTL_SECONDS=21600
SOCIAL_REQUEST_TIMEOUT_MS=30000
SOCIAL_INSTAGRAM_PROCESSING_TIMEOUT_MS=120000

# Meta / Facebook / Instagram
META_GRAPH_API_VERSION=v23.0
META_APP_ID=
META_APP_SECRET=

# TikTok Content Posting API (MVP uses Upload Draft, scope video.upload)
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=